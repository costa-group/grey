+/// Digest of the logs recorded from position _from on (creator, topics and data of each log, in order), as
+/// "<number of logs>:<keccak256>". Used to compare the side effects of two codes on the same test
+std::string logsDigest(EVMHost const& _host, size_t _from)
+{
+	bytes serialized;
+	auto append = [&](uint8_t const* _begin, size_t _size) { serialized.insert(serialized.end(), _begin, _begin + _size); };
+	for (size_t i = _from; i < _host.recorded_logs.size(); ++i)
+	{
+		auto const& log = _host.recorded_logs[i];
+		append(log.creator.bytes, sizeof(log.creator.bytes));
+		serialized.push_back(static_cast<uint8_t>(log.topics.size()));
+		for (auto const& topic: log.topics)
+			append(topic.bytes, sizeof(topic.bytes));
+		uint32_t const dataSize = static_cast<uint32_t>(log.data.size());
+		append(reinterpret_cast<uint8_t const*>(&dataSize), sizeof(dataSize));
+		append(log.data.data(), log.data.size());
+	}
+	return std::to_string(_host.recorded_logs.size() - _from) + ":" + util::keccak256(serialized).hex();
+}
+
+/// Digest of the non-zero storage of every account (accounts and slots are ordered maps), as
+/// "<number of non-zero slots>:<keccak256>"
+std::string storageDigest(EVMHost const& _host)
+{
+	bytes serialized;
+	size_t nonZeroSlots = 0;
+	auto append = [&](uint8_t const* _begin, size_t _size) { serialized.insert(serialized.end(), _begin, _begin + _size); };
+	for (auto const& [address, account]: _host.accounts)
+		for (auto const& [slot, value]: account.storage)
+			if (value.current != evmc::bytes32{})
+			{
+				++nonZeroSlots;
+				append(address.bytes, sizeof(address.bytes));
+				append(slot.bytes, sizeof(slot.bytes));
+				append(value.current.bytes, sizeof(value.current.bytes));
+			}
+	return std::to_string(nonZeroSlots) + ":" + util::keccak256(serialized).hex();
+}
